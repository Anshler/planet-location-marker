{"nodes": [{"id": "docs_architecture", "label": "Planet Location Marker architecture (ARCHITECTURE.md)", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_offline_critical_path", "label": "Offline-first critical path (vendored deps, no CDN)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing on the critical path needs the network; the only optional network use is online place search (open-meteo, then Photon, then Nominatim)."}, {"id": "docs_architecture_rule_pure_modules", "label": "R1: Pure modules (astro, core, geo, data)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They run unchanged in Node tests and in the module worker; import maps do not apply inside workers or Node."}, {"id": "docs_architecture_rule_three_confinement", "label": "R2: Only render, camera, main.js and app import three", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the 3D engine swappable and the rest testable."}, {"id": "docs_architecture_rule_ui_isolation", "label": "R3: UI never imports three or render", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text mode needs the UI to work without WebGL or import maps."}, {"id": "docs_architecture_rule_relative_urls", "label": "R4: All URLs relative", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "L37", "source_url": null, 