{
  "id": "./",
  "name": "Planet Location Marker",
  "short_name": "Planet Marker",
  "description": "Stand anywhere on Earth and see where the Sun, the Moon and every planet are right now — a real-time 3D globe with a beam to each world and the true star sky, computed in your browser.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#03060d",
  "theme_color": "#03060d",
  "categories": ["education", "science", "utilities"],
  "icons": [
    { "src": "assets/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "assets/screenshots/globe-wide.jpg", "sizes": "1280x800", "type": "image/jpeg", "form_factor": "wide",
      "label": "The Earth at night over Ho Chi Minh City, a beam to each world, the Sky dome and tonight's chart" },
    { "src": "assets/screenshots/globe-narrow.jpg", "sizes": "780x1688", "type": "image/jpeg", "form_factor": "narrow",
      "label": "On a phone: the night side of the Earth, beams to the Moon and the planets, and the time bar" }
  ],
  "shortcuts": [
    { "name": "Sky view", "short_name": "Sky", "description": "Stand where you are and look up at the sky", "url": "./#view=sky",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Upcoming events", "short_name": "Events", "description": "Eclipses, conjunctions, meteor showers and the Moon's phases", "url": "./#tab=events",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
