{"nodes": [{"id": "docs_architecture", "label": "Planet Compass architecture (ARCHITECTURE.md)", "file_type": "document", "source_file": "docs/ARCHITECTURE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_rule_pure_modules", "label": "R1: Pure modules (astro, core, geo, data)", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They run unchanged in Node tests and in the module worker; import maps do not apply inside workers or Node."}, {"id": "docs_architecture_rule_three_confinement", "label": "R2: Only render, camera, main.js and app import three", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the 3D engine swappable and the rest testable."}, {"id": "docs_architecture_rule_ui_isolation", "label": "R3: UI never imports three or render", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text mode needs the UI to work without WebGL or import maps."}, {"id": "docs_architecture_rule_relative_urls", "label": "R4: All URLs relative", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The site is served from /planet-location-marker/ on GitHub Pages."}, {"id": "docs_architecture_rule_no_per_frame_allocation", "label": "R5: No per-frame allocation", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steady memory; the smoke test checks geometry and texture counts at 1 day/s."}, {"id": "docs_architecture_rule_shader_tonemapping", "label": "R6: Shader fragments end with tonemapping/colorspace includes", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The includes are no-ops behind the composer and tone-map on the low-tier direct path."}, {"id": "docs_architecture_rule_vector_conventions", "label": "R7: Float64Array vector and matrix conventions", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One convention (row-major 3x3 in pure code, column-major 4x4 for three) and no transposition bugs."}, {"id": "docs_architecture_dynamic_import_split", "label": "Dynamic import of UI and render stack from main.js", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A browser without import maps still gets text mode; a broken UI module leaves the globe running; a broken render module leaves the panels running."}, {"id": "docs_architecture_text_mode", "label": "Text mode (no WebGL2 / no import maps fallback)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a73, \u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_boot_sequence", "label": "Boot sequence (10 steps)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The network is never on the critical path; the UI mounts before WebGL so Sky Now works headless."}, {"id": "docs_architecture_observer_chain", "label": "Observer fallback chain (hash -> prefs -> largest city in device tz -> Greenwich)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_body_classes", "label": "Body classes (is-ready, is-sky, tier-*, no-webgl, is-intro)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_state_data_flow", "label": "State and data flow (UI -> actions -> store -> render modules; clock -> loop)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_snapshot_detail", "label": "Frame vs full snapshot detail (0.5 s staleness, 4 Hz readout)", "file_type": "concept", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_render_on_demand", "label": "Render on demand", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A paused, idle app draws nothing; Live at 1x redraws about twice a second when the snapshot goes stale."}, {"id": "docs_architecture_module_strikes", "label": "Three-strikes module guard", "file_type": "rationale", "source_file": "docs/ARCHITECTURE.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contains failures: a module that throws three times is hidden with one toast; a renderer that keeps throwing hands over to text mode."}, {"id": "docs_architecture_render_module_contract", "label": "RenderModul