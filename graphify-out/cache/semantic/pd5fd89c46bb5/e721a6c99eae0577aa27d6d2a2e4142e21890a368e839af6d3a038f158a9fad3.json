{"nodes": [{"id": "docs_astronomy", "label": "The astronomy behind Planet Compass (ASTRONOMY.md)", "file_type": "document", "source_file": "docs/ASTRONOMY.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_scene_frame", "label": "Scene frame (+Y = J2000 pole, 1 unit = Earth radius)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_s_mapping", "label": "S mapping EQJ -> scene ((x,y,z) -> (x,z,-y))", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_eqj_frame", "label": "EQJ frame (J2000 mean equator and equinox)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_eqd_frame", "label": "EQD frame (true equator and equinox of date)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_earth_fixed_frame", "label": "Earth-fixed frame (EF)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_earth_matrix", "label": "earthMatrix = S\u00b7(PN\u00b7Rz(GAST))\u00b7S\u1d40", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "three's equirectangular SphereGeometry already equals S\u00b7EF, so the Earth texture needs no offset."}, {"id": "docs_astronomy_gast", "label": "Greenwich apparent sidereal time (GAST)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_matrix_layout_gotcha", "label": "Matrix layout gotcha (Astronomy Engine rotation transpose)", "file_type": "rationale", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AE RotateVector uses rot[j][i], so aeRotToM3 transposes; a test checks it against RotateVector to 1e-15."}, {"id": "docs_astronomy_static_sky", "label": "Static sky, moving Earth", "file_type": "rationale", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stars, constellations and the Milky Way are placed once in J2000; precession and nutation appear as the Earth's axis moving inside the fixed sky."}, {"id": "docs_astronomy_observer_geodetic_pin", "label": "Geodetic observer pin on a unit sphere with ENU basis", "file_type": "rationale", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pin normal equals the WGS84 geodetic zenith, so altitudes match Astronomy Engine; the cost is at most about 21 km of position error."}, {"id": "docs_astronomy_light_time_correction", "label": "Light-time correction", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_topocentric_parallax", "label": "Topocentric directions (Moon parallax ~1\u00b0)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_astrometric_vs_apparent", "label": "Astrometric J2000 drawing vs apparent of-date tables", "file_type": "rationale", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The star catalogue is astrometric J2000, so beams drawn in that frame land on the right stars; the tables show what an observer measures. They differ by annual aberration (<=20.5\") plus refraction."}, {"id": "docs_astronomy_true_scale_moon", "label": "True-scale Moon (IAU rotation, libration, Lommel\u2013Seeliger lighting)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The phase is correct by construction from the true Sun direction rather than drawn from MoonPhase."}, {"id": "docs_astronomy_star_colour_model", "label": "Star colour from B\u2212V (Ballesteros + Planck \u00d7 CIE 1931)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_refraction_model", "label": "S\u00e6mundsson refraction (refractionDeg)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors Astronomy Engine's Refraction('normal', h) exactly so the frame pass and AE.Horizon tables agree."}, {"id": "docs_astronomy_twilight_classes", "label": "Twilight classes by solar altitude", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_astronomy_sky_view_exposure", "label": "Sky-view exposure curves (stars, planets, Milky Way)", "file_type": "concept", "source_file": "docs/ASTRONOMY.md", "sour