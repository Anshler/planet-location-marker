{"nodes": [{"id": "github_workflows_ci", "label": "CI workflow (ci.yml)", "file_type": "document", "source_file": ".github/workflows/ci.yml", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_ci_test_job", "label": "CI test job: tests, budgets and headless smoke", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_ci_pinned_chrome", "label": "Pinned Chrome for Testing build (CHROME_VERSION)", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every browser step runs one Chrome for Testing build because SwiftShader WebGL output is deterministic per build; test/golden/meta.json records the build the goldens were made with, so changing the pin makes the golden step skip with a notice until the goldens are rendered again."}, {"id": "github_workflows_ci_hash_checks", "label": "Vendored-file and derived-texture hash checks (fetch-vendor / build-textures --check)", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CI checks hashes only: re-encoding textures is a deliberate, reviewed step because encoder output varies by Chrome version."}, {"id": "github_workflows_ci_generated_data_check", "label": "Generated-data freshness check (build-sky / build-milkyway --check)", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_ci_offline_smoke_matrix", "label": "Offline headless smoke matrix (desktop sub-path, mobile, UTC + reduced motion)", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every external host is unresolvable so boot must never need the network (SPEC \u00a7H); serving under the Pages sub-path makes any absolute URL fail in CI, not in production; the UTC + reduced-motion run exists because v1 died on systems whose time zone is UTC."}, {"id": "github_workflows_ci_offline_reload_smoke", "label": "Offline reload through the service worker (staged site, sub-path)", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": "L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks the offline promise on the site exactly as pages.yml deploys it: the staged sw.js (content-hashed version) precaches from sw-manifest.json, then the page must reload offline from the worker alone."}, {"id": "github_workflows_ci_context_loss_smoke", "label": "Context loss and restore smoke (Medium: composer, MSAA, bloom)", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_ci_performance_gates", "label": "Count-based performance gates (Low 1440x900, High 320x240, then a context loss)", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts, not milliseconds: shader programs and draw calls per tier, no frame drawn in 3 s while paused, twinkle at most 32/s under the 30 Hz cap, no getBoundingClientRect in a frame callback during a time-lapse; High runs at 320x240 so its frames come fast enough for the twinkle cap to matter."}, {"id": "github_workflows_ci_golden_renders", "label": "Golden-render comparison (eight fixed scenes; fail above 0.5 % of pixels moving more than 6/255 luma)", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_ci_goldens_job", "label": "goldens job: render goldens with the pinned Chrome (workflow_dispatch)", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goldens must come from the pinned Chrome on the CI runner, never from a developer machine; the 'goldens' artifact is unzipped into test/golden/ and committed."}], "edges": [{"source": "github_workflows_ci", "target": "github_workflows_ci_test_job", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L29", "weight": 1.0}, {"source": "github_workflows_ci", "target": "github_workflows_ci_goldens_job", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L154", "weight": 1.0}, {"source": "github_workflows_ci", "target": "github_workflows_ci_pinned_chrome", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L22", "weight": 1.0}, {"source": "github_workflows_ci_test_job", "target": "github_workflows_ci_hash_checks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L46", "weight": 1.0}, {"source": "github_workflows_ci_test_job", "target": "github_workflows_ci_generated_data_check", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L53", "weight"